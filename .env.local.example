# Supabase — cloud (desarrollo actual)
# Local Docker opcional; ver stack-tecnologico.md
NEXT_PUBLIC_SUPABASE_URL=https://TU-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud Vision (Sprint 4+)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# En Vercel: JSON inline del service account
GOOGLE_CREDENTIALS_JSON=

# Inngest (Sprint 4+)
# Local: INNGEST_DEV=1 + npm run inngest:dev (no hace falta event/signing key)
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Parallel OCR jobs (default 10). Subir en Inngest plan si >5 en cloud.
OCR_CONCURRENCY=10

# Búsqueda pública por dorsal — rate limit (opcional; defaults en código)
# BIB_SEARCH_WINDOW_SECONDS=3600
# BIB_SEARCH_MAX_DISTINCT=5
# BIB_SEARCH_MAX_SAME=30

# App
# Local: http://localhost:3002
# Production (Vercel): https://tu-dominio.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3002
